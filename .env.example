# =============================================================================
# EXEMPLO DE ARQUIVO DE CONFIGURAÇÃO DE AMBIENTE (.env.example)
# Copie este arquivo para .env e preencha com suas credenciais reais.
# =============================================================================

# String de Conexão com o Banco de Dados PostgreSQL (Neon)
DATABASE_URL=postgresql://seu_usuario:sua_senha@seu_host.neon.tech/neondb?sslmode=require

# Porta em que o servidor Express irá rodar (Padrão: 3000)
PORT=3000

# Senha de Acesso Seguro do Painel da Psicanalista
ADMIN_PASSWORD=sua_senha_segura_aqui
